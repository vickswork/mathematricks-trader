# Git attributes for Mathematricks Trader
# Ensures consistent line endings across Windows, Mac, and Linux

# Default behavior: Use LF for all text files
* text=auto

# Force LF line endings for shell scripts (critical for Docker/Linux)
*.sh text eol=lf

# Force LF for Python scripts
*.py text eol=lf

# Force LF for YAML, JSON, and config files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bson binary

